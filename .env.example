# Copy to .env on the Hostinger VPS. docker-compose.hostinger.yml reads this file.
# Do not commit .env. Rsync leaves the VPS copy in place.
#
# hPanel → Databases shows the host, database, user, and password.
# Use that host, not localhost. localhost inside the app container is the container itself.
# If MySQL is installed on the VPS host, use host.docker.internal instead of the public IP.

SPRING_DATASOURCE_URL=jdbc:mysql://srv000.hstgr.io:3306/u000000000_bank?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=u000000000_bank
SPRING_DATASOURCE_PASSWORD=replace-me
